ANTHROPIC_API_KEY=
# Supabase dashboard > Project Settings (gear icon) > Data API > "Project URL"
SUPABASE_PROJECT_URL=https://your-project.supabase.co
# Supabase dashboard > Project Settings (gear icon) > API Keys > "Publishable key"
# (on older projects it is called "anon public")
SUPABASE_PUBLISHABLE_KEY=your_supabase_key_here
# Supabase dashboard > Project Settings (gear icon) > API Keys > "Secret keys"
# Car Scout uses this one to save conversations and preferences. Never share it.
SUPABASE_SECRET_KEY=
